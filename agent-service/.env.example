DOUYIN_MCP_URL=http://127.0.0.1:6789/mcp
PHASE2_MESSAGE_LIMIT=20
PHASE3_MESSAGE_LIMIT=20
PHASE4_MESSAGE_LIMIT=20
PHASE5_MESSAGE_LIMIT=20
SQLITE_PATH=./data/douyin-agent.db

# Phase 5 sends only when this is explicitly true. Keep false for Dry Run.
AUTO_REPLY_ENABLED=false
AUTO_REPLY_ALLOWLIST=
AUTO_REPLY_BLOCKLIST=
AUTO_REPLY_ALLOW_ALL=false

OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT_MS=30000

# Used by the later continuous polling phase.
POLL_INTERVAL_MS=10000
MESSAGE_DEBOUNCE_MS=5000

MAX_REPLIES_PER_MINUTE=5
MAX_REPLIES_PER_CONTACT_PER_HOUR=10
